# Copy this file to .env.local and fill in your own values.

# The Production URL of the Webhook Trigger node in your
# "ACP - Customer Support Agent" n8n workflow.
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/acp-chat

# Optional. Webhook URL for the "ACP - Announcement Broadcast" workflow.
# Leave blank until you swap that workflow's Manual Trigger for a Webhook Trigger.
N8N_BROADCAST_WEBHOOK_URL=

# From Supabase: Project Settings > API
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Password for the admin dashboard login screen. Change this.
ADMIN_PASSWORD=changeme
